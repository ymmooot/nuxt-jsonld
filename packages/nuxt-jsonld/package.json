{
  "name": "nuxt-jsonld",
  "version": "2.3.1",
  "description": "manage JSON-LD in Vue component.",
  "repository": "ssh://git@github.com/ymmooot/nuxt-jsonld.git",
  "author": "Ryota Yamamoto <ryota.yama.9@gmail.com>",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "test": "vitest",
    "typecheck": "tsc",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "schema-dts": "^2.1.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.0",
    "@unhead/vue": "^3.4.2",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "keywords": [
    "attribute",
    "head",
    "meta",
    "seo",
    "vue",
    "nuxt",
    "jsonld"
  ],
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  }
}
