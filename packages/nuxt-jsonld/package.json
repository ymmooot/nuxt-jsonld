    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.3",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  },
  "keywords": [
