{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "types": ["@nuxt/schema"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "#imports": ["./node_modules/@unhead/vue"]
    }
  },
  "include": ["./src/**/*", "./test/**/*"]
}
